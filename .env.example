# ============================================================
# AdRobot environment configuration
# Copy to .env and fill in real values. Do NOT commit .env.
# ============================================================

# --- Keitaro integration ---
KEITARO_BASE_URL=https://tlgk.host/admin_api/v1
KEITARO_API_TOKEN=change_me
KEITARO_TIMEOUT=30
KEITARO_MAX_RETRIES=3

# Keitaro entities used by the campaign creator (kept out of business logic)
KEITARO_TRAFFIC_SOURCE_ID=836
KEITARO_GROUP_ID=10332
KEITARO_GROUP_TYPE=campaigns
GOOGLE_REDIRECT_URL=https://google.com
DEFAULT_OFFER_SHARE=100

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=adrobot
POSTGRES_USER=adrobot
POSTGRES_PASSWORD=adrobot

# --- RabbitMQ ---
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=adrobot
RABBITMQ_PASSWORD=adrobot
RABBITMQ_VHOST=/

# --- App ---
APP_ENV=dev
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
